rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. USERS COLLECTION ---
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- 2. LOCATIONS COLLECTION ---
    match /locations/{locationId} {
      allow read, write: if true;
    }

    // --- 3. TOUR PACKAGES COLLECTION ---
    match /tour_packages/{packageId} {
      allow read, write: if true;
    }

    // --- 4. SUBMISSIONS COLLECTION ---
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // --- 5. REVIEWS COLLECTION ---
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // --- 6. ITINERARIES COLLECTION ---
    match /itineraries/{itineraryId} {
      allow read, write: if true;
    }

    // --- 7. LOGS COLLECTION ---
    match /logs/{logId} {
      allow read, write: if true;
    }

    // --- 8. NOTIFICATIONS COLLECTION ---
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // --- 9. AI SETTINGS COLLECTION ---
    match /ai_settings/{settingsId} {
      allow read, write: if true;
    }
  }
}

